# Server Configuration
PORT=8000
ORIGIN=http://localhost:5173

# Database
DATABASE_URL=mongodb://localhost:27017/chatapp

# JWT Authentication (must match server JWT_KEY)
JWT_KEY=your-super-secret-jwt-key-change-in-production

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# AI System User ID (MongoDB ObjectId of AI user in database)
AI_SYSTEM_ID=000000000000000000000000

# Node Backend URL (for internal communication)
NODE_BACKEND_URL=http://localhost:8597

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
